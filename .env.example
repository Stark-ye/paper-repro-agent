# Copy this file to `.env` and fill in your own API key.
# Never commit a real API key.

# Qwen / DashScope OpenAI-compatible API
PAPER_REPRO_API_KEY=your_dashscope_api_key_here
PAPER_REPRO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PAPER_REPRO_MODEL=qwen-plus

# Alternative examples:
# OpenAI
# PAPER_REPRO_BASE_URL=https://api.openai.com/v1
# PAPER_REPRO_MODEL=gpt-4.1-mini

# Alibaba Cloud international endpoint
# PAPER_REPRO_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
